# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── App ────────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-use-a-long-random-string
FLASK_DEBUG=false

# ── Database (self-hosted PostgreSQL on VPS via Docker Compose) ────────────────
# These are used by the `db` container in docker-compose.yml.
# The `web` container connects automatically via the internal Docker network.
POSTGRES_DB=frameiq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-use-openssl-rand-base64-32
# Exposed port for GitHub Actions episode sync (firewall to GH runner IPs)
POSTGRES_EXPOSED_PORT=5432
# For local dev WITHOUT Docker, point directly:
# DATABASE_URL=postgresql://postgres:your-password@localhost:5432/frameiq

# ── TMDb ───────────────────────────────────────────────────────────────────────
TMDB_API_KEY=

# ── Streaming ──────────────────────────────────────────────────────────────────
# Default embed source: rive | vidking | vidy | oneembed
# (users can switch sources on any watch page)
STREAM_PROVIDER=rive

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudinary ─────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (optional) ───────────────────────────────────────────────────────────
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@frameiq.studio

# ── Gunicorn tuning (optional) ─────────────────────────────────────────────────
# WEB_WORKERS=2
# WEB_THREADS=4
