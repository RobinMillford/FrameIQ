# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── App ────────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-use-a-long-random-string
FLASK_DEBUG=false

# ── Database ───────────────────────────────────────────────────────────────────
# For local PostgreSQL (docker-compose creates the container automatically).
# The compose file builds the URL as: postgresql://frameiq:<POSTGRES_PASSWORD>@db:5432/frameiq
POSTGRES_PASSWORD=change-me-strong-db-password

# To use Neon or any external PostgreSQL instead, set DATABASE_URL directly
# and remove the DATABASE_URL line from docker-compose.yml:
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# ── TMDb ───────────────────────────────────────────────────────────────────────
TMDB_API_KEY=

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── ChromaDB Cloud ─────────────────────────────────────────────────────────────
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudinary ─────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (optional) ───────────────────────────────────────────────────────────
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@frameiq.studio

# ── Gunicorn tuning (optional) ─────────────────────────────────────────────────
# WEB_WORKERS=2
# WEB_THREADS=4
