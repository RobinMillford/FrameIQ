# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── App ────────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-use-a-long-random-string
FLASK_DEBUG=false

# ── Database (Neon or any PostgreSQL) ─────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# ── TMDb ───────────────────────────────────────────────────────────────────────
TMDB_API_KEY=

# ── Streaming ─────────────────────────────────────────────────────────────────
# Default embed source: rive | vidking | vidy | oneembed
# (users can switch sources on any watch page)
STREAM_PROVIDER=rive

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudinary ─────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (optional) ───────────────────────────────────────────────────────────
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@frameiq.studio

# ── Gunicorn tuning (optional) ─────────────────────────────────────────────────
# WEB_WORKERS=2
# WEB_THREADS=4
